# ===== 一体化部署（docker compose）用：复制为 .env =====
# 在解析服务控制台「API Key」页面生成，只勾选 douyin:read
DTK_API_KEY=dtk_xxxxxxxxxxxx_REPLACE_ME
# 默认带上浏览器容器，用来自动生成抖音身份
COMPOSE_PROFILES=browser
# 局域网访问时改成 0.0.0.0
WEB_BIND_HOST=127.0.0.1
WEB_PORT=3000
# 服务器上启用 HTTPS 时填写域名，并把 COMPOSE_PROFILES 改成 browser,https
DOMAIN=

# ===== 本地开发（npm run dev）用：写进 .env.local =====
# DTK_BASE_URL=http://127.0.0.1:8000
# DTK_API_KEY=同上
